# Preserve the exact byte representation of archived scientific artifacts.
# This is required because train.xyz intentionally has mixed historical line endings.
nep_train/*.xyz -text
nep_train/*.out -text
nep_train/*.in -text
nep_train/*.restart -text
nep_train/nep.txt -text

# Keep repository-authored metadata deterministic across platforms.
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.py text eol=lf
SHA256SUMS.txt text eol=lf

*.png binary
